# 开项 KaiPilot 本地开发环境变量（apps/backend）
# 复制为 .env 后按需修改；生产环境务必替换 APP_KEY。
#
# 说明：本文件只管本机 `pnpm dev` + SQLite 开发路径。
# Docker Compose 目标机部署（v3-docker-compose-runtime-foundation）默认零配置
# `docker compose up -d --build`；其可选覆盖字典见根目录 .env.compose.example，
# 部署说明见应用内帮助中心「部署与运维 → Docker Compose 部署」。

# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=change-me-in-production-min-16-characters
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# CORS（前端 dev 地址，多个用逗号分隔）
# CORS_ORIGIN=http://localhost:3000

# Database (SQLite)
DB_DATABASE=database.sqlite

# =================================================================
# ai-structured-output-poc（dev-only sandbox，不进正式路径）
# =================================================================
# Provider 选型（apply 前置决策）：
#   决策 = OpenAI 兼容（GPT-4o）。策略 N 走 response_format=json_schema，
#   策略 T 走 function/tool calling。SDK = openai。
#   Provider 切换只换 Adapter 实现，AIGateway/schema/校验/恢复层不变（spec 硬约束）。
#
# 安全约束（红线 1 + tasks 1.1）：
#   - key **仅在后端读取**，绝对禁止暴露到前端；
#   - sandbox 路由为 dev-only，NODE_ENV=production 时接口关闭；
#   - 未设置 key 且组织没有可用 AI 连接时，AI 功能提示「请先在设置中添加 AI 连接」；
#     只有显式设置 AI_ALLOW_MOCK=true（测试环境默认开启）才降级为 MockAdapter，
#     只能跑非评测联调，不得用于 M0 判定（spec「M0 必须以真实模型经 Adapter 抽象测定」）。
AI_M0_PROVIDER=openai
AI_M0_MODEL=claude-haiku-4-5-20251001
# OPENAI_API_KEY=sk-...            # apply 期填入真实 key 后启用真实模型评测
# OPENAI_BASE_URL=https://api.openai.com/v1   # 兼容代理时替换
AI_M0_MAX_OUTPUT_TOKENS=4096
AI_M0_REQUEST_TIMEOUT_MS=60000

# =================================================================
# ai-gateway-abstraction / T034（AI 模型连接,自研双协议 Adapter）
# =================================================================
# 连接 API Key 的对称加密 key(AES-256-GCM)。缺失时回退派生自 APP_KEY 并告警;
# 生产建议设置独立随机 key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AI_CONNECTION_ENCRYPTION_KEY=

# =================================================================
# v3-skill-eval-system —— Skill 评估特性门禁（默认关闭）
# =================================================================
# 启用后 /api/v1/ai/compiler/skills/:skillId/eval 端点可访问
# COMPILER_SKILL_EVAL_ENABLED=true

# =================================================================
# v3-skill-compiler-integration —— Skill 知识注入 Compiler Stage（默认关闭）
# =================================================================
# 启用后 Compiler run 在 Intent Parsing 后接线激活决策，
# LLM/hybrid Stage 的 Context Packet 注入 skillKnowledge section
# COMPILER_SKILL_INJECTION_ENABLED=true

# =================================================================
# Google OAuth（Docker Compose 部署段，v3-docker-google-oauth-runtime-wiring）
# =================================================================
# 本机 `pnpm dev` 开发：GOOGLE_OAUTH_CLIENT_JSON_PATH 指向本机凭据文件即可，与既有解析一致。
# Docker Compose 目标机：变量由根目录 .env.compose.example / compose.oauth.yaml
# 推导注入（AIPROJ_GOOGLE_OAUTH_SECRET_FILE → /run/aiproj-secrets/google-oauth-client.json），
# 此处列出的是「容器内最终生效值」的契约说明，仅供核对，绝不在此填写真实值：
#   GOOGLE_OAUTH_CLIENT_JSON_PATH=/run/aiproj-secrets/google-oauth-client.json   # host 文件只读挂载
#   GOOGLE_OAUTH_REDIRECT_URI=https://HOST/api/v1/auth/google/callback          # Google Console 必须登记
#   GOOGLE_AUTH_SUCCESS_REDIRECT_URL=https://HOST/auth/google/callback          # 登录成功前端回调页
#   GOOGLE_AUTH_FAILURE_REDIRECT_URL=https://HOST/login                         # 登录失败回登录页
# 本机 dev 缺省：redirect 为 http://localhost:3333/api/v1/auth/google/callback，
# success/failure 回 http://localhost:3000（FRONTEND_URL 或 APP_URL 推导）。
# 以上四项均有既有 backend env schema（start/env.ts）承载，容器只需注入环境变量，零代码分支。
# 安全边界：secret 只读挂载进 backend，绝不 COPY 进镜像、不暴露给 frontend/edge/migrate。
