# =============================================================================
# 开项 OpenXiang —— Docker Compose 可选覆盖字典（v3-docker-compose-runtime-foundation）
#
# 默认启动【不需要】复制或编辑本文件：`docker compose up -d --build` 开箱即用，
# secret 由 init-config 一次性生成并持久化到 runtime-secret volume。
# 仅当你要长期固定某项配置时：
#   1. 复制本文件为 `.env.compose`（已 gitignore，禁止提交真实凭据）
#   2. 始终使用 `docker compose --env-file .env.compose up -d --build`
# 或在 shell/CI 直接注入同名环境变量（优先级高于 env file）。
# 推荐统一使用 apps/backend/.env 与 `pnpm docker:up`：启动器会按
# AIPROJ_DATABASE_MODE 在 Supabase 栈与内置 PostgreSQL 栈之间选择。
# 本文件保留为旧式 Compose 覆盖字典。
# =============================================================================

# --- Edge（唯一对外端口） ---
# 绑定地址。默认 0.0.0.0（对外开放）；仅本机访问可设 127.0.0.1。
# AIPROJ_BIND_ADDRESS=0.0.0.0
# 对外 HTTP 端口。默认 80（GCP VM 可直接用 external IP 访问）；本机端口冲突时改它。
# AIPROJ_HTTP_PORT=80

# --- Public origin（可选覆盖；Docker 默认 http://localhost） ---
# 常规 UI/REST/WebSocket 全部走 edge 同源相对路径；部署到自己的域名时改成对外访问地址。
# AIPROJ_PUBLIC_ORIGIN=https://pm.example.com

# --- 新 UI 灰度门控（前端构建期内联，改值后必须 --build 重建 frontend 镜像） ---
# 默认 true：旧 UI 顶栏显示「进入新页面」，/next 全组织可达。
# 取值：true|1|on|* = 开启（配了白名单则按白名单）；org_allowlist = 仅白名单；false = 关闭。
# AIPROJ_FF_NEXT_UI=true
# 逗号分隔的组织 ID 白名单，如 1,2,5；留空 = 不限。
# AIPROJ_FF_NEXT_UI_ORGS=

# --- 「源代码」链接（AGPL-3.0 第 13 条；前端构建期内联，改值后必须 --build） ---
# 留空 = 不显示（私有版默认）。修改代码并公开提供服务时，必须指向你修改后的源码。
# AIPROJ_SOURCE_URL=

# --- Google 登录（可选；只接线到 backend） ---
# 默认不启用：没有设置 AIPROJ_GOOGLE_OAUTH_SECRET_FILE 时，登录页的 Google 按钮显示「未配置」。
# 启用方法：在 Google Cloud Console 创建 OAuth 2.0 Web Client，把下载的 client JSON 放在主机上，
# 把路径填进下面的变量，再执行 docker compose up -d 重建 backend。该文件只读挂进 backend，
# 不进入镜像层、frontend 或任何其他服务。
#   Windows 示例：AIPROJ_GOOGLE_OAUTH_SECRET_FILE=C:/secure/google-oauth-client.json
#   Linux 示例：  AIPROJ_GOOGLE_OAUTH_SECRET_FILE=/etc/aiproj/google-oauth-client.json
# AIPROJ_GOOGLE_OAUTH_SECRET_FILE=
# 登录回调由下面的 origin 推导（后端固定拼 /api/v1/auth/google/callback），必须和 Google Console
# 里登记的回调地址完全一致（含协议、域名，不带结尾斜杠）；缺省为 http://localhost。
# AIPROJ_GOOGLE_OAUTH_ORIGIN=https://pm.example.com

# --- 自带 secret（可选；缺省时 init-config 自动生成并复用） ---
# 三项都可独立设置；设置后 init-config 把该值写入 runtime-secret volume（仅首次）。
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# AIPROJ_APP_KEY=
# AIPROJ_JWT_ACCESS_SECRET=
# AIPROJ_POSTGRES_PASSWORD=        # 仅默认 PG 栈使用；SQLite 栈忽略

# --- PostgreSQL（仅默认栈） ---
# AIPROJ_POSTGRES_DB=aiproj
# AIPROJ_POSTGRES_USER=aiproj

# --- Redis ---
# 逻辑库序号（单节点，0-15）。两个栈共用同一约定。
# AIPROJ_REDIS_DB=0

# --- AI 慢推理模型（可选覆盖；两套 Docker 栈默认已启用安全长等待） ---
# 模型不输出思考 token 时也只按整轮硬上限判断，不以流式静默判定断网。
# AI_M0_REQUEST_TIMEOUT_MS=3000000
# AI_ADAPTIVE_CLARIFICATION_ATTEMPT_TIMEOUT_MS=1200000
# AI_ADAPTIVE_CLARIFICATION_ROUND_TIMEOUT_MS=1500000
# AI_DRAFT_TIME_BUDGET_SCALE=5
# AI_DRAFT_OUTPUT_BUDGET_SCALE=5

# --- 矛盾求解（TRIZ）真实模型 ---
# 默认 true：矛盾求解调用组织配置的真实模型（仍需 ai:trigger 权限与可用 AI 连接，失败时如实降级到规则模板）。
# 设为 false 则一律走确定性规则模板、不消耗 Token。
# AIPROJ_TRIZ_ENABLE_REAL_AI=true

# --- Storage ---
# 附件/报表/plugin 导出等正式本机资料固定写入 backend 容器的 /app/storage/uploads，
# 由 named volume（<project>_aiproj-storage）持久化，不提供 env 覆盖——改路径会让
# volume 挂载点与写入路径错位导致静默丢资料。备份/迁移直接对 volume 做快照，
# 操作见应用内帮助中心「部署与运维 → Docker Compose 部署」。
