{
  "name": "aiproj",
  "version": "0.0.0",
  "private": true,
  "description": "开项 Kaiplan — AI-first 简体中文原生专业项目管理平台（monorepo 根）",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "docker:up": "pnpm exec tsx scripts/database-launcher.ts docker-up",
    "db:probe": "pnpm exec tsx scripts/database-launcher.ts probe",
    "db:migrate:supabase": "pnpm exec tsx scripts/database-launcher.ts migrate-supabase",
    "db:admin:create": "pnpm exec tsx scripts/database-launcher.ts admin-create",
    "docker:admin:create": "pnpm exec tsx scripts/database-launcher.ts docker-admin-create",
    "test:database-selection": "tsx --test scripts/database-selection.test.ts",
    "test:toolchain-compat": "node --test scripts/toolchain-compatibility.test.cjs",
    "lint": "turbo run lint",
    "test:e2e": "pnpm --filter @aiproj/e2e run e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "turbo run docs",
    "help:lint": "pnpm --filter @aiproj/frontend help:lint",
    "compatibility-matrix": "pnpm exec tsx scripts/compatibility-matrix.ts",
    "check:plugin-capability-seams": "pnpm exec tsx scripts/check-plugin-capability-seams.ts",
    "check:plugin-manifest": "pnpm exec tsx scripts/check-plugin-manifest.ts",
    "check:plugin-compatibility": "pnpm exec tsx scripts/check-plugin-compatibility-matrix.ts",
    "check:connector-definitions": "pnpm exec tsx scripts/check-connector-definitions.ts",
    "check:docker-compose": "pnpm exec tsx scripts/check-docker-compose.ts",
    "test:docker-runtime-gate": "tsx --test scripts/docker-runtime/socketio-auth-probe.test.ts",
    "gate:docker-runtime": "pnpm exec tsx scripts/docker-runtime-gate.ts",
    "plugin:dev": "pnpm exec tsx scripts/plugin-dev.ts",
    "plugin:seed": "pnpm exec tsx scripts/plugin-seed.ts"
  },
  "devDependencies": {
    "@aiproj/config": "workspace:*",
    "@aiproj/types": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.55.0",
    "@studyzy/openspec-cn": "1.13.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "turbo": "^2.11.5",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.71.0",
    "yaml": "2.9.1"
  },
  "license": "AGPL-3.0-only"
}
