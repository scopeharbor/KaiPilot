        {
          "schemaKey": "demo.input",
          "fields": [
            {
              "fieldKey": "title",
              "type": "string",
              "required": true,
              "description": "标题"
            },
            {
              "fieldKey": "count",
              "type": "integer",
              "required": false,
              "description": "数量"
            }
          ]
        },
        {
          "schemaKey": "demo.output",
