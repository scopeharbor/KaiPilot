# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
# 应用密钥（加密与签名）：复制为 .env 后在 apps/backend 执行 `node ace generate:key` 自动写入。
APP_KEY=
# 可选的独立加密密钥（AI 连接的 API Key、两步验证密钥）。留空时由 APP_KEY 派生并在日志告警；
# 生产建议各填一个独立随机值，填好后不要再改，否则已加密的数据无法解密：
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# AI_CONNECTION_ENCRYPTION_KEY=
# TWO_FACTOR_ENCRYPTION_KEY=
AI_ADAPTIVE_CLARIFICATION_ENABLED=true
# AI 模型：各组织在「设置 → AI 连接」里添加自己的模型与 API Key。
# 下面是部署者可选的实例级默认 Key：组织还没有可用连接时回退使用（OpenAI 兼容接口）。
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# AI_M0_MODEL=
# 既没有 AI 连接也没有上面的 Key 时，AI 草案、AI 同事、矛盾求解会提示「请先在设置中添加 AI 连接」。
# 仅联调时可设为 true，改用输出固定样例的 Mock 模型（结果不是真实模型输出）。
# AI_ALLOW_MOCK=false
# 全局模型请求超时（毫秒）。默认 50 分钟；不输出思考 token 的慢推理模型也按整轮等待。
# AI_M0_REQUEST_TIMEOUT_MS=3000000
# 自适应意图分析：单次模型请求 20 分钟、整轮 25 分钟（原默认的 5 倍）。
# AI_ADAPTIVE_CLARIFICATION_ATTEMPT_TIMEOUT_MS=1200000
# AI_ADAPTIVE_CLARIFICATION_ROUND_TIMEOUT_MS=1500000
# AI 草案生成墙钟预算倍率（1–10，默认 5 = 全程 125 分钟 / WBS 阶段 40 分钟 / 单次请求 40 分钟）。
# AI_DRAFT_TIME_BUDGET_SCALE=5
# 单次 provider 请求超时绝对值（毫秒，30000–3600000），优先于倍率。
# AI_DRAFT_REQUEST_TIMEOUT_MS=480000
# 输出长度预算倍率（1–5，默认 5 = WBS 阶段 125 万字符 / 全程 500 万字符）。
# 超大项目或忽略 max_tokens 的 provider 撞字符上限（同样报 GENERATION_BUDGET_EXHAUSTED）时再调大。
# AI_DRAFT_OUTPUT_BUDGET_SCALE=5
# Optional persistent anonymous DSH client identity; defaults to storage/secrets in the backend.
# AI_DSH_IDENTITY_PATH=/absolute/path/to/dsh-anonymous-user-id
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:3000

#--------------------------------------------------------------------
# 数据库切换（Supabase 优先 / SQLite / Docker 内置 PostgreSQL）
#
# 这个项目支持用同一套代码在 SQLite 和 PostgreSQL 之间切换：
#
# 只需切换 AIPROJ_DATABASE_MODE：
#   auto     = 优先 Supabase；本机失败退 SQLite，Docker 失败退内置 PostgreSQL（推荐）
#   supabase = 强制 Supabase，连接失败即停止
#   local    = 本机强制 SQLite，Docker 强制内置 PostgreSQL
# 本机 `pnpm dev` 与 Docker `pnpm docker:up` 都读取 apps/backend/.env。
#
# 2. 使用 PostgreSQL / Supabase：
#    - 设置 DB_CONNECTION=pg。
#    - 必须填写 DB_HOST / DB_PORT / DB_USER / DB_PASSWORD，并把 DB_DATABASE 改为
#      PG database 名称（单一命名契约：DB_DATABASE 在 PG 方言下表示 database 名）。
#    - Supabase direct database host 通常是 db.<project-ref>.supabase.co:5432；
#      如果本机或部署环境没有 IPv6，启动器会尝试 session pooler：
#      host 形如 aws-0-<region>.pooler.supabase.com，port 为 5432，
#      user 通常为 postgres.<project-ref>。
#    - Supabase 一般需要 DB_SSL=true。
#    - 如果 Node 报 self-signed certificate in certificate chain，可在本机或该托管连接上设置
#      DB_SSL_REJECT_UNAUTHORIZED=false；正式生产环境若有受信任 CA，应优先使用严格校验。
#
# 3. 字段含义：
#    - DB_CONNECTION：当前启用连接，允许 sqlite 或 pg。
#    - DB_DATABASE：SQLite 方言下为文件路径；PG 方言下为 database 名称（Supabase
#      默认通常是 postgres）。两种方言共用此变量，切换连接时同步切换取值。
#    - DB_HOST：PG/Supabase 主机名。
#    - DB_PORT：PG/Supabase 端口，本机 PG 常用 5432，Supabase pooler 常用 6543。
#    - DB_USER：PG/Supabase 用户名；Supabase pooler 常用 postgres.<project-ref>。
#    - DB_PASSWORD：PG/Supabase 数据库密码。只写在本机 .env 或部署平台 secret，不要提交真实值。
#    - DB_SSL：是否启用 PG SSL。
#    - DB_SSL_REJECT_UNAUTHORIZED：是否严格校验证书链。
#    - DB_POOL_MIN / DB_POOL_MAX：PG 连接池大小。本机/Supabase 免费层可先用 0/3。
#
# 4. 测试环境：
#    - apps/backend/.env.test 固定 DB_CONNECTION=sqlite，避免单元测试误写真实 Supabase。
#    - 如需专门跑 PG 测试，请显式设置独立测试库，不要直接使用生产/真实协作库。
#--------------------------------------------------------------------

# 个人版本机默认使用 SQLite；需要远程 PostgreSQL 时按上方说明显式配置。
AIPROJ_DATABASE_MODE=local
AIPROJ_SQLITE_DATABASE=database.sqlite
DB_CONNECTION=sqlite

# SQLite（DB_CONNECTION=sqlite 时生效）
# 开发环境数据库文件。测试环境可通过 DB_TEST_DATABASE 使用独立文件，避免污染开发库。
DB_DATABASE=database.sqlite

# PostgreSQL（DB_CONNECTION=pg 时必需；DB_DATABASE 改填 PG database 名）
# 本机 PostgreSQL 示例：
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_DATABASE=aiproj_dev
# DB_SSL=false
# DB_POOL_MIN=2
# DB_POOL_MAX=10

# Supabase direct + session pooler（把占位符换成 Supabase 面板中的值）：
# DB_HOST=db.<project-ref>.supabase.co
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=<password>
# DB_DATABASE=postgres
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false
# DB_POOL_MIN=0
# DB_POOL_MAX=3
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_DIRECT_HOST=db.<project-ref>.supabase.co
# SUPABASE_DB_DIRECT_PORT=5432
# SUPABASE_DB_DIRECT_USER=postgres
# SUPABASE_DB_POOLER_HOST=aws-0-<region>.pooler.supabase.com
# SUPABASE_DB_POOLER_PORT=5432
# SUPABASE_DB_POOLER_USER=postgres.<project-ref>
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=                 # 后端专用，绝不能使用 NEXT_PUBLIC_* 名称
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# JWT (HS256, access TTL 15m, refresh TTL 8h)
# 务必换成随机值，例如 `openssl rand -hex 32`，或
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-256-bit-secret-here
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=8h

# Limiter（登录失败锁定 SEC-03 / 速率限制 SEC-10）
# 默认 memory（单进程内存）。redis 仅在 REDIS_ENABLED=true 时可选，用于承载跨进程/跨重启的限流状态。
# LIMITER_STORE=redis 但 REDIS_ENABLED 未开时后端会启动失败（禁止静默回退，避免限流语义与预期不符）。
LIMITER_STORE=memory

#--------------------------------------------------------------------
# Redis 最小运行基础（v2-redis-minimum-runtime-support）
# 默认关闭：不设置 REDIS_ENABLED 时后端以单节点内存模式运行，零外部依赖，
# 限流与缓存均走内存实现。仅当你有本机 Redis 服务并希望共享限流状态/缓存加速时启用。
# 未启用或不可达时能力自动回退单节点内存，禁止因缺 Redis 导致默认启动或默认测试失败。
# 本项目仅支持单节点 Redis：不引入 Redis Cluster、Sentinel。
# 容器化单机部署（用户授权的 v3-docker-compose-runtime-foundation）通过
# 根目录 compose.yaml / compose.sqlite.yaml 注入 REDIS_ENABLED=true + REDIS_HOST=redis，
# 本文件只管本机 `pnpm dev` 开发路径；K8s/Helm/集群编排仍不做。
#--------------------------------------------------------------------
# REDIS_ENABLED=true
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_TLS=false
# REDIS_CONNECT_TIMEOUT=10000
# REDIS_MAX_RETRIES=1

#--------------------------------------------------------------------
# WebSocket / Socket.IO 实时传输底座（单节点，不需要 Redis）
# 当 REALTIME_ENABLED=false 时，WebSocket 通道完全关闭，REST 读写不受影响。
# 后续多节点时需引入 @socket.io/redis-adapter，但在那之前不需要 Redis。
#--------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
REALTIME_ENABLED=true
REALTIME_PING_INTERVAL_MS=25000
REALTIME_PING_TIMEOUT_MS=20000
REALTIME_CONNECT_TIMEOUT_MS=30000
REALTIME_MAX_CONNECTIONS=1024

#--------------------------------------------------------------------
# V2 Google OAuth 登录 + Google Calendar 真实连接（全部可选）
# 不填写时本地启动、默认测试、站内通知和项目日历都照常运行；登录页/设置页会显示“未配置”。
# 这些值只代表 GCP OAuth 应用配置；用户真实连接仍必须点击按钮并完成 Google 授权。
# GCP 位置：Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID。
# Authorized redirect URIs 至少填写下面两个回调地址：
#   1. Google 登录回调：http://localhost:3333/api/v1/auth/google/callback
#   2. Google 日历绑定回调：http://localhost:3333/api/v1/integrations/google_calendar/callback
# 生产环境请把 localhost 换成真实后端域名。
#--------------------------------------------------------------------
# 推荐方式：把 Google 下载的 client_secret JSON 放到后端私密目录，再只填写这个路径。
# JSON 内必须包含 web.client_id、web.client_secret，并在 redirect_uris 中包含下面两个回调地址。
# 如果登录和日历绑定共用同一个 GCP OAuth Client，只填这一项即可。
# GOOGLE_CLIENT_SECRET_JSON_PATH=storage/secrets/google-oauth-client.local.json

# Google OAuth 系统登录：登录页“使用 Google 登录”使用这一组。
# 可二选一：填写上面的 JSON 路径，或在这里手填 Client ID/Secret。
# 如需登录单独使用另一个 JSON，可填写 GOOGLE_OAUTH_CLIENT_JSON_PATH。
# GOOGLE_OAUTH_CLIENT_JSON_PATH=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3333/api/v1/auth/google/callback
# GOOGLE_AUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/auth/google/callback
# GOOGLE_AUTH_FAILURE_REDIRECT_URL=http://localhost:3000/login

# Google Calendar 真实绑定：/settings/integrations 的 Google Calendar 使用这一组。
# 需要在 GCP 同项目启用 Google Calendar API。
# 可二选一：填写上面的 JSON 路径，或在这里手填 Client ID/Secret。
# 如需日历绑定单独使用另一个 JSON，可填写 GOOGLE_CALENDAR_CLIENT_JSON_PATH。
# GOOGLE_CALENDAR_CLIENT_JSON_PATH=
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3333/api/v1/integrations/google_calendar/callback

# 第三方 token 加密密钥：生产必须填写独立随机值，建议至少 32 字符。
# 可用命令示例：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# INTEGRATION_TOKEN_ENCRYPTION_KEY=

# Microsoft Entra admin center > App registrations
# OUTLOOK_CALENDAR_CLIENT_ID=
# OUTLOOK_CALENDAR_CLIENT_SECRET=
# OUTLOOK_CALENDAR_REDIRECT_URI=http://localhost:3333/api/v1/integrations/outlook_calendar/callback

# Slack API > Your Apps > OAuth & Permissions
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_REDIRECT_URI=http://localhost:3333/api/v1/integrations/slack/callback

# 飞书开放平台 > 企业自建应用 > 凭证与基础信息
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_REDIRECT_URI=http://localhost:3333/api/v1/integrations/feishu/callback

# 钉钉开放平台 > 企业内部应用 > 应用信息
# DINGTALK_APP_ID=
# DINGTALK_APP_SECRET=
# DINGTALK_REDIRECT_URI=http://localhost:3333/api/v1/integrations/dingtalk/callback

#--------------------------------------------------------------------
# v2-5-streaming-websocket-service —— Streaming WebSocket Service 特性门禁
# 启用时后台长任务（AI Draft、Compiler Stage events、34-stage code generation）
# 可通过 WebSocket 订阅流式进度。关闭时不阻塞 REST/SSE/status fallback 路径。
# 本地开发默认启用，测试环境应显式设置。
#--------------------------------------------------------------------
STREAMING_WS_ENABLED=true
STREAMING_WS_HEARTBEAT_INTERVAL_MS=25000
STREAMING_WS_HEARTBEAT_TIMEOUT_MS=20000
STREAMING_WS_REPLAY_RETENTION_SEC=300

#--------------------------------------------------------------------
# v2-5-compiler-stage-cache-wiring —— deterministic Compiler Stage 缓存特性门禁
# 默认启用：Orchestrator 仅为 deterministic Stage 接版本化缓存（加速层，命中与否输出等价）。
# 设为 false 即本地 feature-off：handler 直连，行为与接线前一致且不写 cache summary。
# 不引入 Redis/Docker 依赖——store 由 resolveCacheStore() 按 Redis 可用性解析，缺省走内存。
#--------------------------------------------------------------------
# COMPILER_STAGE_CACHE_ENABLED=true

#--------------------------------------------------------------------
# v2-5-webhook-ip-allowlist —— 入站 webhook 来源 IP 允许清单（网络层纵深防御）
# 默认关闭：未设置时中间件 no-op，对现网零影响，且已挂载在 POST /api/v1/webhooks/:provider。
# 开启后仅放行来源 IP 命中 CIDR 清单的请求，未命中返回 403 WEBHOOK_IP_FORBIDDEN。
# CIDRS 为逗号分隔的 CIDR（IPv4/IPv6 皆可）。留空且 ENABLED=true = 全拒（fail-closed，视为误配）。
# 默认值可参考 app/services/security/webhook_provider_cidrs.ts 的 GitHub/GitLab 静态源段快照。
# 禁止写入任何真实 secret。
#--------------------------------------------------------------------
# WEBHOOK_IP_ALLOWLIST_ENABLED=false
# WEBHOOK_IP_ALLOWLIST_CIDRS=192.30.252.0/22,185.199.108.0/22,140.82.112.0/20

#--------------------------------------------------------------------
# v2-5-pwa-web-push-notifications —— PWA Web Push 推送通知（默认关闭，fixture-first）
#
# 默认关闭：未授权环境下订阅 UI 隐藏、API 拒绝、发送 no-op。
# 生产发送需同时启用 PWA_WEB_PUSH_ENABLED、PWA_WEB_PUSH_SEND_ENABLED、
# 设置 PWA_WEB_PUSH_SENDER_MODE=production 并填入完整 VAPID 凭证。
# 真实 Push Service 外发需用户明确授权后才可执行。
#--------------------------------------------------------------------
# PWA_WEB_PUSH_ENABLED=false
# PWA_WEB_PUSH_SEND_ENABLED=false
# PWA_WEB_PUSH_SENDER_MODE=fixture
# PWA_WEB_PUSH_VAPID_PUBLIC_KEY=
# PWA_WEB_PUSH_VAPID_PRIVATE_KEY=
# PWA_WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com

# v3-skill-registry-and-lifecycle —— Compiler Skill Registry 特性门禁。默认关。
COMPILER_SKILL_REGISTRY_ENABLED=false

# v3-initial-skill-software-development —— 内置 Skill 种子注入特性门禁。默认关。
# 启用后 seeder 注入内置 Skill、API 暴露 isBuiltin 标识、前端渲染徽章/筛选/副本入口。
COMPILER_SKILL_BUILTIN_SEED_ENABLED=false
