{
  "name": "@aiproj/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "开项 OpenXiang 后端（AdonisJS 7）",
  "scripts": {
    "start": "node --import tsx build/bin/server.js",
    "build": "node ace build",
    "dev": "tsx ../../scripts/database-launcher.ts local-dev",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run",
    "test:integration": "node ace test",
    "test:coverage": "pnpm run test:coverage:services && pnpm run test:coverage:permissions",
    "test:coverage:services": "c8 --include=\"app/services/**/*.ts\" --include=\"app/policies/**/*.ts\" --exclude=\"app/services/ai_m0/**/*.ts\" --check-coverage --lines 90 --reporter=text node ace test --no-clear",
    "test:coverage:permissions": "c8 --include=\"app/services/rbac_service.ts\" --include=\"app/policies/**/*.ts\" --check-coverage --lines 95 --reporter=text node ace test --no-clear",
    "lint": "eslint .",
    "codegen:indexes": "node --import tsx ./bin/codegen_indexes.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm run codegen:indexes && tsc --noEmit"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js",
    "#types/*": "./app/types/*.js",
    "#rbac": "./start/rbac/index.js",
    "#rbac/*": "./start/rbac/*.js"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.5.2",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/limiter": "^3.0.1",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/redis": "^10.0.2",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@aiproj/compiler-spec": "workspace:^",
    "@aiproj/types": "workspace:*",
    "@anthropic-ai/sdk": "^0.129.0",
    "@japa/api-client": "^3.2.1",
    "@napi-rs/canvas": "^1.0.9",
    "@paralleldrive/cuid2": "^3.3.0",
    "@poppinss/utils": "^7.1.1",
    "@tuyau/core": "^1.2.2",
    "@vinejs/vine": "^4.4.0",
    "@xmldom/xmldom": "^0.9.12",
    "better-sqlite3": "^13.0.3",
    "jose": "^6.2.12",
    "luxon": "^3.7.2",
    "mammoth": "^1.13.0",
    "openai": "^7.23.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.3.289",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15",
    "tyme4ts": "^1.5.2",
    "xml-crypto": "^6.3.2",
    "xpath": "^0.0.34",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.5.2",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@aiproj/config": "workspace:*",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/cliui": "^6.8.1",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "c8": "^12.0.0",
    "eslint": "^10.11.0",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "typescript": "7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "yaml": "2.9.1",
    "youch": "^4.1.1"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "license": "AGPL-3.0-only"
}
