{
  "name": "@aiproj/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "开项 KaiPilot TypeScript SDK — 类型化 /api/v1 客户端（项目/任务/域 client + escape hatch）",
  "license": "AGPL-3.0-only",
  "sideEffects": false,
  "engines": {
    "node": ">=26"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aiproj/types": "workspace:*"
  },
  "devDependencies": {
    "@aiproj/config": "workspace:*",
    "@types/node": "^26.6.3",
    "typescript": "7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
